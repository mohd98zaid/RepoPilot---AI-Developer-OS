{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoPilot",
  "version": "0.1.0",
  "identifier": "dev.repopilot.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8000 http://localhost:5173; connect-src 'self' http://127.0.0.1:8000 http://localhost:5173; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/repopilot-server/": "backend/",
      "../../docs/licenses/": "licenses/",
      "../../docs/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../LICENSE": "LICENSE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
